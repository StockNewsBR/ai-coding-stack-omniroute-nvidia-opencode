# Copy to .env only in your PRIVATE local environment. Never commit real values.

# OmniRoute client/API key generated by OmniRoute itself
OMNIROUTE_API_KEY=YOUR_OMNIROUTE_KEY
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# Provider keys
NVIDIA_API_KEY=YOUR_NVIDIA_KEY
NVIDIA_NIM_API_KEY=YOUR_NVIDIA_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENCODE_API_KEY=YOUR_OPENCODE_KEY
ZAI_API_KEY=YOUR_ZAI_KEY
GROQ_API_KEY=YOUR_GROQ_KEY
FIREWORKS_API_KEY=YOUR_FIREWORKS_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY

# Optional SonarQube
SONARQUBE_TOKEN=YOUR_SONAR_TOKEN
SONARQUBE_ORG=YOUR_ORG
SONARQUBE_URL=https://sonarcloud.io
