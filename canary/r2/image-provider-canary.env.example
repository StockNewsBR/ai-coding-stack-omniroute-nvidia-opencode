# OMNIROUTE_IMAGE_PAID_FALLBACK_CANARY_R1_1_RETRY - canary environment template (R2)
#
# NON-SECRET template ONLY. Copy to a local, UNTRACKED file and fill values there.
# NEVER commit real credentials. Placeholders below are intentionally inert.
#
# Usage (do NOT source this file directly into a repository):
#   set -a; . ./image-provider-canary.env.local; set +a
#   node --import tsx/esm canary/r2/spend-guard.ts
#
# The paid image fallback stays DISABLED unless IMAGE_PAID_FALLBACK_ENABLED=true
# AND all three budgets are set (see open-sse/config/paidImagePolicy.ts).

# ---------------------------------------------------------------------------
# Global switch (canary sets true; committed default in code remains false)
# ---------------------------------------------------------------------------
IMAGE_PAID_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# AWS / Amazon Bedrock -> Stability AI image route (NON-SECRET knobs)
# ---------------------------------------------------------------------------
AWS_IMAGE_REGION=
AWS_IMAGE_MODEL_ID=

# ---------------------------------------------------------------------------
# Meta Model API -> Muse image route (NON-SECRET knobs)
# ---------------------------------------------------------------------------
META_IMAGE_MODEL_ID=
META_IMAGE_BASE_URL=https://api.meta.ai/v1

# ---------------------------------------------------------------------------
# Hard spend limits (canary: 1 image per provider, USD 0.10 total ceiling)
# ---------------------------------------------------------------------------
IMAGE_PAID_MAX_COST_PER_IMAGE=
IMAGE_PAID_DAILY_BUDGET=
IMAGE_PAID_MONTHLY_BUDGET=
IMAGE_PAID_ALLOW_PROVIDERS=aws-bedrock-image,meta-muse-image

# ---------------------------------------------------------------------------
# SECRETS - placeholders only. Set these OUT-OF-BAND (shell/secret manager),
# never in a tracked file, never echoed. Names only; no values here.
#
# AWS Bedrock API key (bearer), per open-sse/executors/bedrock.ts:
#   AWS_BEARER_TOKEN_BEDROCK=<set-out-of-band-never-commit>
#   BEDROCK_API_KEY=<accepted alias, set only one>
#
# Meta Model API key (bearer):
#   MODEL_API_KEY=<set-out-of-band-never-commit>
#   META_API_KEY=<accepted alias, set only one>
# ---------------------------------------------------------------------------
