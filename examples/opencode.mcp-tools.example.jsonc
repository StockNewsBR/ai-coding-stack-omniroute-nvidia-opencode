{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent",
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}

// Add Serena/SonarQube using their current upstream instructions.
// Never put SonarQube tokens or provider API keys directly in a public file.
